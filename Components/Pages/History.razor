@page "/history"
@using SpendInsights.Models
@using SpendInsights.Data
@inject AppDatabase Database

<div class="history-page">
    <div class="history-header">
        <h1>Köphistorik</h1>
        <p>Se dina tidigare köp och vad de innehöll.</p>
    </div>

    @if (purchases.Count == 0)
    {
        <div class="empty-state">
            <p>Du har inga sparade köp ännu.</p>
        </div>
    }
    else
    {
        <div class="purchase-list">
            @foreach (var purchase in purchases)
            {
                <div class="purchase-card">

                    <button class="purchase-summary"
                            @onclick="() => TogglePurchase(purchase.Id)">

                        <div class="purchase-main">
                            <span class="store-name">@purchase.StoreName</span>
                            <span class="purchase-date">
                                @purchase.PurchaseDate.ToString("dd MMMM yyyy")
                            </span>
                        </div>

                        <div class="purchase-right">
                            <span class="purchase-total">
                                @purchase.TotalSum.ToString("0.00") kr
                            </span>

                            <span class="expand-icon">
                                @(expandedPurchaseId == purchase.Id ? "▲" : "▼")
                            </span>
                        </div>
                    </button>

                    @if (expandedPurchaseId == purchase.Id)
                    {
                        <div class="purchase-details">
                            @if (purchase.Items.Count == 0)
                            {
                                <p class="no-items">Inga produkter sparade.</p>
                            }
                            else
                            {
                                @foreach (var item in purchase.Items)
                                {
                                    <div class="purchase-item">
                                        <div class="item-name">
                                            @item.ItemName
                                        </div>

                                        <div class="item-amount">
                                            @item.Amount st
                                        </div>

                                        <div class="item-price">
                                            @item.Price.ToString("0.00") kr
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }

                </div>
            }
        </div>
    }
</div>

@code {
    private List<Purchase> purchases = [];
    private int? expandedPurchaseId;

    private void TogglePurchase(int purchaseId)
    {
        expandedPurchaseId =
            expandedPurchaseId == purchaseId
                ? null
                : purchaseId;
    }

    protected override async Task OnInitializedAsync()
    {
        purchases = await Database.GetPurchasesAsync();
    }
}