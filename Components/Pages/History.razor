@page "/history"
@using SpendInsights.Models
@using SpendInsights.Data
@inject AppDatabase Database

<h1>Köphistorik</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Butik</th>
                <th>Datum</th>
                <th>Summa</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var purchase in purchases)
            {
                <tr>
                    <td>@purchase.StoreName</td>
                    <td>@purchase.PurchaseDate.ToString("yyyy-MM-dd")</td>
                    <td>@purchase.TotalSum kr</td>
                    <td>
                    <button class="btn btn-sm btn-secondary" @onclick="() => TogglePurchase(purchase.Id)">
                            Visa
                        </button>
                    </td>
                </tr>
            @if (expandedPurchaseId == purchase.Id)
            {
           
        
                <tr>
                    <td colspan="4">
                        @foreach (var item in purchase.Items)
                        {
                          <tr>

                            <td>@item.ItemName</td>
                            <td>@item.Amount st</td>
                            @* <td>@item.Weight</td> *@
                            <td>@item.Price kr</td>
                            
                          </tr>
                        }
                    </td>
                </tr>
             
            }
            }

        </tbody>
    </table>


@code {
    private List<Purchase> purchases = [];
    private int? expandedPurchaseId;

    private void TogglePurchase(int purchaseId)
    {
        if (expandedPurchaseId == purchaseId)
        {
            expandedPurchaseId = null;
        }
        else
        {
            expandedPurchaseId = purchaseId;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        purchases = await Database.GetPurchasesAsync();
    }
}