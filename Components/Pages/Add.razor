@page "/add"
@using SpendInsights.Models
@using SpendInsights.Data
@inject AppDatabase Database

<div class="receipt-page">

    <div class="page-header">
        <h3>Skapa kvitto</h3>
        <p>Lägg till information om köpet och produkterna.</p>
    </div>

    <div class="receipt-card">

        <div class="receipt-row">
            <div class="form-field">
                <label>Butik</label>
                <input class="form-control"
                       placeholder="Ex. ICA Maxi"
                       @bind="purchase.StoreName" />
            </div>

            <div class="form-field">
                <label>Datum</label>
                <InputDate class="form-control"
                           @bind-Value="purchase.PurchaseDate" />
            </div>
        </div>

        <div class="form-field">
            <label>Kommentar</label>
            <textarea class="form-control comment-field"
                      placeholder="Valfri kommentar..."
                      @bind="purchase.Comment">
            </textarea>
        </div>

    </div>

    <div class="products-section">

        <div class="products-header">
            <h4>Produkter</h4>

            <button class="btn btn-primary add-product-btn"
                    @onclick="OpenProductModal">
                + Lägg till produkt
            </button>
        </div>

        @if (purchase.Items.Any())
        {
            <div class="product-list">
                @foreach (var item in purchase.Items)
                {
                    <div class="product-row">


                        <div class="product-name">
                            @item.ItemName
                        </div>

                        <div class="product-amount">
                            @item.Amount st
                        </div>

                        <div class="product-delete" ">
                            <button class="delete-item"
                                    @onclick="() => RemoveItem(item)">
                                ×
                            </button>
                        </div>

                        <div class="product-price">
                            @item.Price.ToString("0.00") kr
                        </div>

                   
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-products">
                Inga produkter tillagda ännu.
            </div>
        }

        <div class="total-row">
            <span>Totalt</span>
            <strong>@purchase.TotalSum.ToString("0.00") kr</strong>
        </div>

    </div>

    @if (purchaseSaved)
    {
        <div class="save-message">
            Kvittot är sparat!
        </div>
    }

    <button class="save-button"
            @onclick="SavePurchase">
        Spara kvitto
    </button>

</div>


@if (showProductModal)
{
    <div class="modal-backdrop-custom"
         @onclick="CloseProductModal">

        <div class="product-modal"
             @onclick:stopPropagation>

            <div class="modal-header-custom">
                <h4>Lägg till produkt</h4>

                <button class="close-button"
                        @onclick="CloseProductModal">
                    ×
                </button>
            </div>

            <div class="form-field">
                <label>Produktnamn</label>
                <input class="form-control"
                       placeholder="Ex. Köttfärs"
                       @bind="newItem.ItemName" />
            </div>

            <div class="receipt-row">

                <div class="form-field">
                    <label>Antal</label>
                    <InputNumber class="form-control"
                                 @bind-Value="newItem.Amount" />
                </div>

                <div class="form-field">
                    <label>Pris</label>
                    <InputNumber class="form-control"
                                 @bind-Value="newItem.Price" />
                </div>

            </div>

            <div class="modal-actions">
                <button class="cancel-button"
                        @onclick="CloseProductModal">
                    Avbryt
                </button>

                <button class="btn btn-primary"
                        @onclick="AddItem">
                    Lägg till
                </button>
            </div>

        </div>
    </div>
}


@code {

    private Purchase purchase = new();
    private PurchaseItem newItem = new();

    private bool purchaseSaved = false;
    private bool showProductModal = false;

    private void OpenProductModal()
    {
        showProductModal = true;
    }

    private void CloseProductModal()
    {
        showProductModal = false;
    }

    private void AddItem()
    {
        purchase.Items.Add(newItem);

        newItem = new PurchaseItem();

        showProductModal = false;
    }

    private void RemoveItem(PurchaseItem item)
    {
        purchase.Items.Remove(item);
    }

    private async Task SavePurchase()
    {
        await Database.SavePurchaseAsync(purchase);

        purchaseSaved = true;
    }
}