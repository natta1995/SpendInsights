@page "/add"
@using SpendInsights.Models

<h3>Skapa kvitto</h3>

<div class="mb-3">
    <label class="form-label">Butik</label>
    <input class="form-control" @bind="purchase.StoreName" />
</div>

<div class="mb-3">
    <label class="form-label">Datum</label>
    <InputDate class="form-control" @bind-Value="purchase.PurchaseDate" />
</div>

<div class="mb-3">
    <label class="form-label">Kommentar</label>
    <input class="form-control" @bind="purchase.Comment" />
</div>

<hr />

<h4>Lägg till produkt</h4>

<div class="mb-3">
    <label class="form-label">Produktnamn</label>
    <input class="form-control" @bind="newItem.ItemName" />
</div>

<div class="mb-3">
    <label class="form-label">Pris</label>
    <InputNumber class="form-control" @bind-Value="newItem.Price" />
</div>

<div class="mb-3">
    <label class="form-label">Antal</label>
    <InputNumber class="form-control" @bind-Value="newItem.Amount" />
</div>

<div class="mb-3">
    <label class="form-label">Vikt</label>
    <InputNumber class="form-control" @bind-Value="newItem.Weight" />
</div>

<div>
    <button class="btn btn-primary" @onclick="AddItem">
    Lägg till produkt
    </button>
</div>

@if (purchase.Items.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Produkt</th>
                <th>Antal</th>
                <th>Vikt</th>
                <th>Pris</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in purchase.Items)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>@item.Amount</td>
                    <td>@item.Weight</td>
                    <td>@item.Price kr</td>
                </tr>
            }
        </tbody>
    </table>
}
 <p><strong>Totalt: @purchase.TotalSum kr</strong></p>

<div>

<button class="btn btn-accept">
    Spara kvitto
</button>
</div>



@code {
    private Purchase purchase = new();
    private PurchaseItem newItem = new();

    private void AddItem()
    {
        purchase.Items.Add(newItem);
        newItem = new PurchaseItem();
    }
}
